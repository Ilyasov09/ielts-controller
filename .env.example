# @BotFather dan olingan token
BOT_TOKEN=123456789:AAAA-your-bot-token

# Admin Telegram ID lari (vergul bilan). Bo‘sh qoldirilsa — botga birinchi /start bosgan odam egasi bo‘ladi.
# O‘z ID ingizni @userinfobot orqali bilib olishingiz mumkin.
ADMIN_IDS=

# PostgreSQL. Docker Compose ishlatsangiz o‘zgartirmang.
DATABASE_URL=postgresql+asyncpg://ielts:ielts@db:5432/ielts
POSTGRES_USER=ielts
POSTGRES_PASSWORD=ielts
POSTGRES_DB=ielts

# Vaqt zonasi (barcha jadval va sanalar shu bo‘yicha)
TIMEZONE=Asia/Tashkent

# Birinchi ishga tushirishdagi standart vaqtlar (keyin bot ichida o‘zgartiriladi)
DEFAULT_REPORT_TIME=21:00
DEFAULT_COUNTDOWN_TIME=09:00

LOG_LEVEL=INFO
